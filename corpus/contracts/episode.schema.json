{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.dev/schemas/episode.json",
  "title": "Episode",
  "description": "A coherent interaction narrative grouping related signals, events and decisions.",
  "type": "object",
  "required": ["title"],
  "properties": {
    "episode_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "RESOLVED", "ESCALATED", "ARCHIVED"],
      "default": "ACTIVE"
    },
    "signal_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "products_involved": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/EpisodeEvent" },
      "default": []
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "outcome": {
      "type": ["string", "null"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "$defs": {
    "EpisodeEvent": {
      "title": "EpisodeEvent",
      "type": "object",
      "required": ["event_type"],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "SIGNAL_RECEIVED",
            "INTERRUPT_TRIGGERED",
            "DECISION_MADE",
            "CHECKPOINT_CLEARED",
            "CHECKPOINT_BLOCKED",
            "ESCALATED",
            "RESOLVED"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "product_id": { "type": ["string", "null"] },
        "signal_id": { "type": ["string", "null"] },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      }
    }
  }
}
