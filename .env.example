# Corpus environment configuration — copy to .env and fill in values.

# Server
CORPUS_HOST=0.0.0.0
CORPUS_PORT=8000
CORPUS_DB_PATH=corpus.db
CORPUS_LOG_LEVEL=INFO

# Authentication (disabled by default for local dev)
CORPUS_AUTH_ENABLED=false
CORPUS_API_KEY=

# Rate limiting (disabled by default)
CORPUS_RATE_LIMIT_ENABLED=false
CORPUS_RATE_LIMIT_RPS=100

# CLI target URL
CORPUS_URL=http://localhost:8000
